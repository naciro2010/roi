{
  "name": "roi-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:store": "VITE_DEMO=false vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "visuels": "node scripts/generer-visuels.mjs",
    "natif:visuels": "capacitor-assets generate --android --ios --iconBackgroundColor '#070707' --iconBackgroundColorDark '#070707' --splashBackgroundColor '#EFEBE2' --splashBackgroundColorDark '#131211'",
    "natif:sync": "npm run build:store && cap sync",
    "android": "npm run natif:sync && cap open android",
    "ios": "npm run natif:sync && cap open ios",
    "version:natif": "node scripts/version-natif.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
